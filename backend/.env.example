# CodeAtlas Backend Configuration

# Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Git Cloner Storage Directory (defaults to system temporary directory if empty)
# Windows example: C:/Users/username/AppData/Local/Temp/codeatlas
# Linux/macOS example: /tmp/codeatlas
STORAGE_BASE_DIR=

# File ingestion limits
MAX_FILE_SIZE_BYTES=512000
CLONE_TIMEOUT_SECONDS=60

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

